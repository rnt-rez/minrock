---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.stars - a.data.stars || b.data.date.valueOf() - a.data.date.valueOf());

const topProjects = allProjects.filter((p) => p.data.featured).slice(0, 2);
const categories = ['All', ...new Set(allProjects.map((p) => p.data.category))];
---

<BaseLayout title="Projects" description="Open-source tools, themes, and developer utilities.">
  <div class="projects-container">
    <header class="page-header">
      <h1 class="page-title">Projects</h1>
      <p class="page-subtitle">Open-source tools, themes, and developer utilities.</p>
    </header>

    {topProjects.length > 0 && (
      <section class="featured-section">
        <h2 class="section-title">Highlights &amp; Featured</h2>
        <div class="featured-grid">
          {topProjects.map((proj) => (
            <ProjectCard
              title={proj.data.title}
              description={proj.data.description}
              date={proj.data.date}
              slug={proj.id}
              tags={proj.data.tags}
              stars={proj.data.stars}
              repoUrl={proj.data.repoUrl}
              demoUrl={proj.data.demoUrl}
              category={proj.data.category}
              emoji={proj.data.emoji}
            />
          ))}
        </div>
      </section>
    )}

    <section class="all-projects-section" id="projects-list-section">
      <div class="section-header">
        <h2 class="section-title">
          <span>All Projects</span>
          <span class="section-arrow">→</span>
        </h2>

        <!-- Search Filter Box (Live) -->
        <div class="search-wrap">
          <div class="search-box">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              type="text"
              id="search-input"
              placeholder="Filter projects..."
              aria-label="Filter projects"
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="filter-bar" role="group" aria-label="Filter by category">
        {categories.map((cat) => (
          <button
            type="button"
            class={`filter-btn${cat === 'All' ? ' active' : ''}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Projects List -->
      <div class="projects-list" id="projects-list">
        {allProjects.map((proj) => (
          <div
            class="project-item"
            data-category={proj.data.category}
            data-title={proj.data.title.toLowerCase()}
            data-description={proj.data.description.toLowerCase()}
            data-tags={proj.data.tags.join(' ').toLowerCase()}
          >
            <ProjectCard
              title={proj.data.title}
              description={proj.data.description}
              date={proj.data.date}
              slug={proj.id}
              tags={proj.data.tags}
              stars={proj.data.stars}
              repoUrl={proj.data.repoUrl}
              demoUrl={proj.data.demoUrl}
              category={proj.data.category}
              emoji={proj.data.emoji}
            />
          </div>
        ))}
      </div>

      <div id="no-results" class="no-results" style="display: none;">
        <p>No projects found matching your filter.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function setupProjectFilters() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const projectItems = document.querySelectorAll<HTMLElement>('.project-item');
    const noResults = document.getElementById('no-results');

    let currentCategory = 'All';
    let searchQuery = '';

    function applyFilters() {
      let visibleCount = 0;
      const query = searchQuery.trim().toLowerCase();

      projectItems.forEach((item) => {
        const cat = item.dataset.category || '';
        const title = item.dataset.title || '';
        const desc = item.dataset.description || '';
        const tags = item.dataset.tags || '';

        const matchesCat = currentCategory === 'All' || cat === currentCategory;
        const matchesSearch = !query || title.includes(query) || desc.includes(query) || tags.includes(query);

        if (matchesCat && matchesSearch) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = btn.dataset.category || 'All';
        applyFilters();
      });
    });
  }

  setupProjectFilters();
  document.addEventListener('astro:after-swap', setupProjectFilters);
</script>

<style>
  .projects-container {
    padding-top: 1rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 2.4rem;
    letter-spacing: -0.025em;
  }

  .page-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin: 0;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.35rem;
    margin-bottom: 1.25rem;
  }

  .section-arrow {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .featured-section {
    margin-bottom: 3.5rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 700px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }

  .all-projects-section {
    margin-top: 2rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .search-wrap {
    flex: 1;
    max-width: 400px;
    min-width: 240px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--bg-surface);
    color: var(--text-muted);
  }

  .search-box input {
    width: 100%;
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    outline: none;
  }

  .search-box input::placeholder {
    color: var(--text-muted);
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.35rem 0.75rem;
    font-size: 0.82rem;
    font-family: var(--font-mono);
    border: 1px solid var(--border);
    border-radius: 9999px;
    background-color: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background-color: var(--bg-subtle);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .no-results {
    padding: 2.5rem 0;
    text-align: center;
    color: var(--text-muted);
  }
</style>
