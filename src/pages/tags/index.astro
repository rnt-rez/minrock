---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const projects = await getCollection('projects');

// Aggregate tags with counts across both blog articles and projects
const tagCounts: Record<string, number> = {};
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
projects.forEach((proj) => {
  proj.data.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags | Minrock" description="Explore articles by topic and tag.">
  <header class="tags-header">
    <h1 class="tags-h1">Explore by Tag</h1>
    <p class="tags-subtitle">Browse notes and articles grouped by topics.</p>
  </header>

  <div class="tags-cloud">
    {sortedTags.map(([tag, count]) => (
      <a href={`/tags/${tag}`} class="tag-pill">
        <span class="tag-name">#{tag}</span>
        <span class="tag-count">{count}</span>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .tags-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .tags-h1 {
    font-size: 2.25rem;
    margin-top: 0;
    margin-bottom: 0.5rem;
    letter-spacing: -0.025em;
  }

  .tags-subtitle {
    margin: 0;
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1rem 0;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: 0.95rem;
    color: var(--text);
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .tag-pill:hover {
    background-color: var(--bg-subtle);
    border-color: var(--accent);
    color: var(--accent);
  }

  .tag-name {
    font-weight: 600;
  }

  .tag-count {
    font-size: 0.8rem;
    color: var(--text-muted);
    background-color: var(--bg-subtle);
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
  }
</style>
