---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const allProjects = await getCollection('projects');

  const uniqueTags = [
    ...new Set([
      ...allPosts.flatMap((post) => post.data.tags || []),
      ...allProjects.flatMap((proj) => proj.data.tags || []),
    ]),
  ];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    const filteredProjects = allProjects
      .filter((proj) => proj.data.tags?.includes(tag))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    return {
      params: { tag },
      props: { posts: filteredPosts, projects: filteredProjects, tag },
    };
  });
}

const { posts, projects = [], tag } = Astro.props;
const totalCount = posts.length + projects.length;
---

<BaseLayout
  title={`#${tag} | Minrock`}
  description={`Browse content tagged with #${tag}`}
>
  <header class="tag-header">
    <div class="tag-breadcrumb">
      <a href="/tags">Tags</a>
      <span class="sep">/</span>
      <span class="current">#{tag}</span>
    </div>
    <h1 class="tag-title">Content tagged with <span class="highlight">#{tag}</span></h1>
    <p class="tag-count">{totalCount} {totalCount === 1 ? 'item' : 'items'} found ({posts.length} articles, {projects.length} projects)</p>
  </header>

  {posts.length > 0 && (
    <section class="tag-section">
      <h2 class="section-title">Articles ({posts.length})</h2>
      <div class="posts-list">
        {posts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section class="tag-section projects-tag-section">
      <h2 class="section-title">Projects ({projects.length})</h2>
      <div class="projects-grid">
        {projects.map((proj) => (
          <ProjectCard
            title={proj.data.title}
            description={proj.data.description}
            date={proj.data.date}
            slug={proj.id}
            tags={proj.data.tags}
            stars={proj.data.stars}
            repoUrl={proj.data.repoUrl}
            demoUrl={proj.data.demoUrl}
            category={proj.data.category}
            emoji={proj.data.emoji}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .tag-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .tag-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .tag-breadcrumb a {
    color: var(--accent);
  }

  .tag-title {
    font-size: 2.25rem;
    margin-top: 0;
    margin-bottom: 0.5rem;
    letter-spacing: -0.025em;
  }

  .highlight {
    color: var(--accent);
  }

  .tag-count {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .tag-section {
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 1.3rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem;
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
