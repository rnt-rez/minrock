---
// LanguageSelector component with translation options (PT, EN, ES, FR, DE, RU, ZH)
---

<div class="lang-selector" id="lang-selector">
  <button id="lang-btn" class="lang-btn-inner" aria-label="Select language" aria-haspopup="true" aria-expanded="false" title="Language / Idioma">
    <!-- Language Globe / Translate Icon -->
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m5 8 6 6"></path>
      <path d="m4 14 6-6 2-3"></path>
      <path d="M2 5h12"></path>
      <path d="M7 2h1"></path>
      <path d="m22 22-5-10-5 10"></path>
      <path d="M14 18h6"></path>
    </svg>
    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-left:1px;opacity:0.7;">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div id="lang-dropdown" class="lang-dropdown" role="menu" aria-label="Available languages">
    <div class="lang-dropdown-header">LANGUAGE</div>
    <button class="lang-option" data-lang="en" role="menuitem">🇺🇸 English</button>
    <button class="lang-option" data-lang="pt" role="menuitem">🇧🇷 Português</button>
    <button class="lang-option" data-lang="es" role="menuitem">🇪🇸 Español</button>
    <button class="lang-option" data-lang="fr" role="menuitem">🇫🇷 Français</button>
    <button class="lang-option" data-lang="de" role="menuitem">🇩🇪 Deutsch</button>
    <button class="lang-option" data-lang="ru" role="menuitem">🇷🇺 Русский</button>
    <button class="lang-option" data-lang="zh-CN" role="menuitem">🇨🇳 中文</button>
  </div>
</div>

<style>
  .lang-selector {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .lang-btn-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    padding: 0;
  }

  .lang-btn-inner:hover {
    color: var(--text);
    background-color: var(--bg-subtle);
    border-color: var(--accent);
  }

  .lang-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem;
    min-width: 155px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1000;
    animation: langDropdownFade 0.15s ease;
  }

  .lang-dropdown.open {
    display: block;
  }

  @keyframes langDropdownFade {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lang-dropdown-header {
    font-size: 0.68rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-muted);
    padding: 0.25rem 0.65rem 0.35rem;
    letter-spacing: 0.06em;
    opacity: 0.8;
  }

  .lang-option {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.4rem 0.65rem;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    color: var(--text);
    background: transparent;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .lang-option:hover {
    background-color: var(--bg-subtle);
    color: var(--accent);
  }
</style>

<script>
  function setupLanguageSelector() {
    const btn = document.getElementById('lang-btn');
    const dropdown = document.getElementById('lang-dropdown');
    const selector = document.getElementById('lang-selector');

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      // Close other dropdowns if open
      document.querySelectorAll('.theme-dropdown.open, .social-dropdown-menu.open').forEach(d => d.classList.remove('open'));
      document.querySelectorAll('#theme-toggle-btn, #social-menu-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));

      const open = dropdown?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(!!open));
    });

    document.addEventListener('click', (e) => {
      if (!selector?.contains(e.target as Node)) {
        dropdown?.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dropdown?.classList.contains('open')) {
        dropdown.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
        btn?.focus();
      }
    });

    function applyLanguage(lang: string) {
      const host = window.location.hostname;

      if (lang === 'en') {
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; SameSite=Lax; Secure;';
        document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${host}; SameSite=Lax; Secure;`;
        document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.${host}; SameSite=Lax; Secure;`;
      } else {
        document.cookie = `googtrans=/en/${lang}; path=/; SameSite=Lax; Secure;`;
        document.cookie = `googtrans=/en/${lang}; path=/; domain=${host}; SameSite=Lax; Secure;`;
        document.cookie = `googtrans=/auto/${lang}; path=/; SameSite=Lax; Secure;`;
        document.cookie = `googtrans=/auto/${lang}; path=/; domain=${host}; SameSite=Lax; Secure;`;
      }

      const select = document.querySelector<HTMLSelectElement>('.goog-te-combo');
      if (select) {
        select.value = lang;
        select.dispatchEvent(new Event('change'));
      } else {
        // Load Google Translate script if not loaded
        loadGoogleTranslateScript(() => {
          setTimeout(() => {
            const sel = document.querySelector<HTMLSelectElement>('.goog-te-combo');
            if (sel) {
              sel.value = lang;
              sel.dispatchEvent(new Event('change'));
            } else {
              window.location.reload();
            }
          }, 300);
        });
      }
    }

    function loadGoogleTranslateScript(cb: () => void) {
      if (document.getElementById('google-translate-script')) {
        cb();
        return;
      }
      (window as any).googleTranslateElementInit = function() {
        new (window as any).google.translate.TranslateElement({ pageLanguage: 'en' }, 'google_translate_element');
        cb();
      };
      const s = document.createElement('script');
      s.id = 'google-translate-script';
      s.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
      document.body.appendChild(s);
    }

    document.querySelectorAll<HTMLButtonElement>('.lang-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        const lang = opt.dataset.lang;
        if (!lang) return;
        dropdown?.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
        applyLanguage(lang);
      });
    });
  }

  setupLanguageSelector();
  document.addEventListener('astro:after-swap', setupLanguageSelector);
</script>
<div id="google_translate_element" style="display:none;"></div>
