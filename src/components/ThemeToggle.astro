---
// src/components/ThemeToggle.astro
// Dropdown menu for Minrock themes (Clean White, Warm Paper, Slate Navy, Midnight OLED, Auto)
---

<div class="theme-selector" id="theme-selector">
  <button
    id="theme-toggle-btn"
    class="theme-btn-trigger"
    aria-label="Select color theme"
    aria-haspopup="true"
    aria-expanded="false"
    title="Color theme / Tema visual"
  >
    <span id="theme-active-icon" class="theme-active-icon">📜</span>
    <svg class="theme-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <!-- Floating Theme Dropdown -->
  <div id="theme-dropdown" class="theme-dropdown" role="menu" aria-label="Available themes">
    <div class="theme-dropdown-header">THEME</div>

    <button class="theme-option" data-theme-val="white" role="menuitem">
      <span class="theme-opt-left">
        <span class="theme-emoji">☀️</span>
        <span class="theme-label">Clean White</span>
      </span>
      <svg class="theme-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    </button>

    <button class="theme-option" data-theme-val="cream" role="menuitem">
      <span class="theme-opt-left">
        <span class="theme-emoji">📜</span>
        <span class="theme-label">Warm Paper</span>
      </span>
      <svg class="theme-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    </button>

    <button class="theme-option" data-theme-val="slate" role="menuitem">
      <span class="theme-opt-left">
        <span class="theme-emoji">⚓</span>
        <span class="theme-label">Slate Navy</span>
      </span>
      <svg class="theme-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    </button>

    <button class="theme-option" data-theme-val="midnight" role="menuitem">
      <span class="theme-opt-left">
        <span class="theme-emoji">🌌</span>
        <span class="theme-label">Midnight OLED</span>
      </span>
      <svg class="theme-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    </button>

    <div class="theme-divider"></div>

    <button class="theme-option" data-theme-val="auto" role="menuitem">
      <span class="theme-opt-left">
        <span class="theme-emoji">💻</span>
        <span class="theme-label">System Auto</span>
      </span>
      <svg class="theme-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    </button>
  </div>
</div>

<style>
  .theme-selector {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .theme-btn-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background-color: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    padding: 0;
  }

  .theme-btn-trigger:hover {
    color: var(--text);
    background-color: var(--bg-subtle);
    border-color: var(--accent);
  }

  .theme-active-icon {
    font-size: 1rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .theme-chevron {
    opacity: 0.6;
    margin-left: -1px;
    transition: transform 0.15s ease;
  }

  .theme-btn-trigger[aria-expanded="true"] .theme-chevron {
    transform: rotate(180deg);
  }

  .theme-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem;
    min-width: 175px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1000;
    animation: themeDropdownFade 0.15s ease;
  }

  .theme-dropdown.open {
    display: block;
  }

  @keyframes themeDropdownFade {
    from {
      opacity: 0;
      margin-top: -4px;
    }
    to {
      opacity: 1;
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .theme-dropdown {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      max-width: calc(100vw - 24px);
    }
  }

  .theme-dropdown-header {
    font-size: 0.68rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-muted);
    padding: 0.25rem 0.65rem 0.35rem;
    letter-spacing: 0.06em;
    opacity: 0.8;
  }

  .theme-divider {
    height: 1px;
    background-color: var(--border);
    margin: 0.3rem 0;
  }

  .theme-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    text-align: left;
    padding: 0.45rem 0.65rem;
    font-size: 0.84rem;
    font-family: var(--font-sans);
    color: var(--text);
    background: transparent;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease;
    gap: 0.5rem;
  }

  .theme-opt-left {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .theme-emoji {
    font-size: 0.95rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
  }

  .theme-label {
    font-weight: 500;
  }

  .theme-option:hover {
    background-color: var(--bg-subtle);
    color: var(--accent);
  }

  .theme-option.active {
    color: var(--accent);
    font-weight: 600;
    background-color: var(--bg-subtle);
  }

  .theme-check {
    display: none;
    color: var(--accent);
    flex-shrink: 0;
  }

  .theme-option.active .theme-check {
    display: block;
  }
</style>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle-btn');
    const dropdown = document.getElementById('theme-dropdown');
    const selector = document.getElementById('theme-selector');
    const activeIcon = document.getElementById('theme-active-icon');

    const themeIcons: Record<string, string> = {
      white: '☀️',
      cream: '📜',
      slate: '⚓',
      midnight: '🌌',
      auto: '💻',
    };

    function getEffectiveTheme(mode: string): string {
      if (mode === 'auto') {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'slate' : 'cream';
      }
      return mode;
    }

    function updateThemeUI(storedTheme: string) {
      const effectiveTheme = getEffectiveTheme(storedTheme);
      
      // Update icon on the button
      if (activeIcon) {
        activeIcon.textContent = storedTheme === 'auto' ? '💻' : (themeIcons[effectiveTheme] || '📜');
      }

      // Update active checks in dropdown
      document.querySelectorAll<HTMLButtonElement>('.theme-option').forEach((opt) => {
        const val = opt.getAttribute('data-theme-val');
        if (val === storedTheme) {
          opt.classList.add('active');
          opt.setAttribute('aria-selected', 'true');
        } else {
          opt.classList.remove('active');
          opt.removeAttribute('aria-selected');
        }
      });
    }

    function applyTheme(mode: string) {
      localStorage.setItem('minrock_theme', mode);
      const effective = getEffectiveTheme(mode);
      document.documentElement.setAttribute('data-theme', effective);

      updateThemeUI(mode);

      // Dispatch event for reactive components (like ScatterLeaf chameleon mode)
      window.dispatchEvent(new CustomEvent('minrock-theme-change', { detail: { theme: effective, mode } }));
    }

    function positionDropdown() {
      if (!dropdown) return;
      if (window.innerWidth <= 768) {
        dropdown.style.left = '50%';
        dropdown.style.right = 'auto';
        dropdown.style.transform = 'translateX(-50%)';

        const rect = dropdown.getBoundingClientRect();
        const pad = 12;
        if (rect.left < pad) {
          const offset = pad - rect.left;
          dropdown.style.transform = `translateX(calc(-50% + ${offset}px))`;
        } else if (rect.right > window.innerWidth - pad) {
          const offset = rect.right - (window.innerWidth - pad);
          dropdown.style.transform = `translateX(calc(-50% - ${offset}px))`;
        }
      } else {
        dropdown.style.left = '';
        dropdown.style.right = '';
        dropdown.style.transform = '';
      }
    }

    // Initialize UI on mount
    const saved = localStorage.getItem('minrock_theme') || 'cream';
    updateThemeUI(saved);

    // Toggle dropdown
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      // Close other dropdowns if open
      document.querySelectorAll('.lang-dropdown.open, .social-dropdown-menu.open').forEach(d => d.classList.remove('open'));
      document.querySelectorAll('#lang-btn, #social-menu-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));

      const open = dropdown?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(!!open));

      if (open) {
        positionDropdown();
      }
    });

    window.addEventListener('resize', () => {
      if (dropdown?.classList.contains('open')) {
        positionDropdown();
      }
    });

    // Option clicks
    document.querySelectorAll<HTMLButtonElement>('.theme-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        const val = opt.getAttribute('data-theme-val');
        if (!val) return;
        dropdown?.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
        applyTheme(val);
      });
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!selector?.contains(e.target as Node)) {
        dropdown?.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dropdown?.classList.contains('open')) {
        dropdown.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
        btn?.focus();
      }
    });

    // Listen to OS theme changes if on auto
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      const current = localStorage.getItem('minrock_theme') || 'cream';
      if (current === 'auto') {
        applyTheme('auto');
      }
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
