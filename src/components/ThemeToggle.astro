---
// src/components/ThemeToggle.astro
// Dropdown menu for Minrock themes (Clean White, Warm Paper, Slate Navy, Midnight OLED, Auto)
import HeaderControlButton from './HeaderControlButton.astro';

const themes = [
  { value: 'white', emoji: '☀️', label: 'Clean White' },
  { value: 'cream', emoji: '📜', label: 'Warm Paper' },
  { value: 'slate', emoji: '⚓', label: 'Slate Navy' },
  { value: 'midnight', emoji: '🌌', label: 'Midnight OLED' },
];
const autoTheme = { value: 'auto', emoji: '💻', label: 'System Auto' };
---

<HeaderControlButton
  id="theme-selector"
  triggerId="theme-toggle-btn"
  dropdownId="theme-dropdown"
  label="Select color theme"
  title="Color theme / Tema visual"
  menuLabel="Available themes"
  menuHeader="THEME"
>
  <span slot="icon" id="theme-active-icon" class="theme-active-icon">📜</span>

  {themes.map((theme) => (
    <button class="theme-option" data-theme-val={theme.value} role="menuitem">
      <span class="theme-opt-left">
        <span class="theme-emoji">{theme.emoji}</span>
        <span class="theme-label">{theme.label}</span>
      </span>
      <svg class="theme-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    </button>
  ))}

  <div class="theme-divider"></div>

  <button class="theme-option" data-theme-val={autoTheme.value} role="menuitem">
    <span class="theme-opt-left">
      <span class="theme-emoji">{autoTheme.emoji}</span>
      <span class="theme-label">{autoTheme.label}</span>
    </span>
    <svg class="theme-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
  </button>
</HeaderControlButton>

<style>
  .theme-active-icon {
    font-size: 1rem;
    line-height: 1;
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .theme-divider {
    height: 1px;
    background-color: var(--border);
    margin: 0.3rem 0;
  }

  .theme-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    text-align: left;
    padding: 0.45rem 0.65rem;
    font-size: 0.84rem;
    font-family: var(--font-sans);
    color: var(--text);
    background: transparent;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease;
    gap: 0.5rem;
  }

  .theme-opt-left {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .theme-emoji {
    font-size: 0.95rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
  }

  .theme-label {
    font-weight: 500;
  }

  .theme-option:hover {
    background-color: var(--bg-subtle);
    color: var(--accent);
  }

  .theme-option.active {
    color: var(--accent);
    font-weight: 600;
    background-color: var(--bg-subtle);
  }

  .theme-check {
    display: none;
    color: var(--accent);
    flex-shrink: 0;
  }

  .theme-option.active .theme-check {
    display: block;
  }
</style>

<script>
  function setupThemeToggle() {
    const activeIcon = document.getElementById('theme-active-icon');

    const themeIcons: Record<string, string> = {
      white: '☀️',
      cream: '📜',
      slate: '⚓',
      midnight: '🌌',
      auto: '💻',
    };

    function getEffectiveTheme(mode: string): string {
      if (mode === 'auto') {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'slate' : 'cream';
      }
      return mode;
    }

    function updateThemeUI(storedTheme: string) {
      const effectiveTheme = getEffectiveTheme(storedTheme);
      
      // Update icon on the button
      if (activeIcon) {
        activeIcon.textContent = storedTheme === 'auto' ? '💻' : (themeIcons[effectiveTheme] || '📜');
      }

      // Update active checks in dropdown
      document.querySelectorAll<HTMLButtonElement>('.theme-option').forEach((opt) => {
        const val = opt.getAttribute('data-theme-val');
        if (val === storedTheme) {
          opt.classList.add('active');
          opt.setAttribute('aria-selected', 'true');
        } else {
          opt.classList.remove('active');
          opt.removeAttribute('aria-selected');
        }
      });
    }

    function applyTheme(mode: string) {
      localStorage.setItem('minrock_theme', mode);
      const effective = getEffectiveTheme(mode);
      document.documentElement.setAttribute('data-theme', effective);

      updateThemeUI(mode);

      // Dispatch event for reactive components (like ScatterLeaf chameleon mode)
      window.dispatchEvent(new CustomEvent('minrock-theme-change', { detail: { theme: effective, mode } }));
    }

    // Initialize UI on mount
    const saved = localStorage.getItem('minrock_theme') || 'cream';
    updateThemeUI(saved);

    // Option clicks
    document.querySelectorAll<HTMLButtonElement>('.theme-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        const val = opt.getAttribute('data-theme-val');
        if (!val) return;
        applyTheme(val);
      });
    });

    // Listen to OS theme changes if on auto
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      const current = localStorage.getItem('minrock_theme') || 'cream';
      if (current === 'auto') {
        applyTheme('auto');
      }
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
