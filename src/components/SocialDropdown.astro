---
// src/components/SocialDropdown.astro
// Compact dropdown menu grouping social media and contact links
import { siteConfig } from '../config/site';
---

<div class="social-dropdown-container" id="social-dropdown-container">
  <button
    id="social-menu-btn"
    class="social-btn-trigger"
    aria-label="Connect and social links"
    aria-haspopup="true"
    aria-expanded="false"
    title="Connect / Redes e Contato"
  >
    <!-- Social / At icon -->
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"></path>
    </svg>
    <svg class="social-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <!-- Floating Social Dropdown -->
  <div id="social-dropdown-menu" class="social-dropdown-menu" role="menu" aria-label="Social and contact options">
    <div class="social-dropdown-header">CONNECT</div>

    {siteConfig.socialLinks.linkedin && (
      <a
        href={siteConfig.socialLinks.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="social-menu-item"
        role="menuitem"
      >
        <span class="social-item-icon linkedin-color">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6 1.6 1.6 0 0 0-1.6-1.6Z"/>
          </svg>
        </span>
        <div class="social-item-info">
          <span class="social-item-name">LinkedIn</span>
          <span class="social-item-handle">↗ renato-rz</span>
        </div>
      </a>
    )}

    {siteConfig.socialLinks.github && (
      <a
        href={siteConfig.socialLinks.github}
        target="_blank"
        rel="noopener noreferrer"
        class="social-menu-item"
        role="menuitem"
      >
        <span class="social-item-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </span>
        <div class="social-item-info">
          <span class="social-item-name">GitHub</span>
          <span class="social-item-handle">↗ rnt-rez</span>
        </div>
      </a>
    )}

    {siteConfig.socialLinks.email && (
      <a
        href={`mailto:${siteConfig.socialLinks.email}`}
        class="social-menu-item"
        role="menuitem"
      >
        <span class="social-item-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </span>
        <div class="social-item-info">
          <span class="social-item-name">Email</span>
          <span class="social-item-handle">↗ Send message</span>
        </div>
      </a>
    )}
  </div>
</div>

<style>
  .social-dropdown-container {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .social-btn-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background-color: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    padding: 0;
  }

  .social-btn-trigger:hover {
    color: var(--text);
    background-color: var(--bg-subtle);
    border-color: var(--accent);
  }

  .social-chevron {
    opacity: 0.6;
    margin-left: -1px;
    transition: transform 0.15s ease;
  }

  .social-btn-trigger[aria-expanded="true"] .social-chevron {
    transform: rotate(180deg);
  }

  .social-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem;
    min-width: 175px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1000;
    animation: socialDropdownFade 0.15s ease;
  }

  .social-dropdown-menu.open {
    display: block;
  }

  @keyframes socialDropdownFade {
    from {
      opacity: 0;
      margin-top: -4px;
    }
    to {
      opacity: 1;
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .social-dropdown-menu {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      max-width: calc(100vw - 24px);
    }
  }

  .social-dropdown-header {
    font-size: 0.68rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-muted);
    padding: 0.25rem 0.65rem 0.35rem;
    letter-spacing: 0.06em;
    opacity: 0.8;
  }

  .social-menu-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.65rem;
    border-radius: 5px;
    text-decoration: none;
    color: var(--text);
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .social-menu-item:hover {
    background-color: var(--bg-subtle);
    color: var(--accent);
  }

  .social-item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 0.12s ease, border-color 0.12s ease;
  }

  .social-menu-item:hover .social-item-icon {
    color: var(--accent);
    border-color: var(--accent);
  }

  .social-item-icon.linkedin-color {
    color: #0a66c2;
  }

  .social-item-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }

  .social-item-name {
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--text);
  }

  .social-menu-item:hover .social-item-name {
    color: var(--accent);
  }

  .social-item-handle {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    line-height: 1.1;
  }
</style>

<script>
  function setupSocialDropdown() {
    const btn = document.getElementById('social-menu-btn');
    const dropdown = document.getElementById('social-dropdown-menu');
    const container = document.getElementById('social-dropdown-container');

    function positionDropdown() {
      if (!dropdown) return;
      if (window.innerWidth <= 768) {
        dropdown.style.left = '50%';
        dropdown.style.right = 'auto';
        dropdown.style.transform = 'translateX(-50%)';

        const rect = dropdown.getBoundingClientRect();
        const pad = 12;
        if (rect.left < pad) {
          const offset = pad - rect.left;
          dropdown.style.transform = `translateX(calc(-50% + ${offset}px))`;
        } else if (rect.right > window.innerWidth - pad) {
          const offset = rect.right - (window.innerWidth - pad);
          dropdown.style.transform = `translateX(calc(-50% - ${offset}px))`;
        }
      } else {
        dropdown.style.left = '';
        dropdown.style.right = '';
        dropdown.style.transform = '';
      }
    }

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      // Close other dropdowns if open
      document.querySelectorAll('.lang-dropdown.open, .theme-dropdown.open').forEach(d => d.classList.remove('open'));
      document.querySelectorAll('#lang-btn, #theme-toggle-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));

      const open = dropdown?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(!!open));

      if (open) {
        positionDropdown();
      }
    });

    window.addEventListener('resize', () => {
      if (dropdown?.classList.contains('open')) {
        positionDropdown();
      }
    });

    document.addEventListener('click', (e) => {
      if (!container?.contains(e.target as Node)) {
        dropdown?.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dropdown?.classList.contains('open')) {
        dropdown.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
        btn?.focus();
      }
    });
  }

  setupSocialDropdown();
  document.addEventListener('astro:after-swap', setupSocialDropdown);
</script>
