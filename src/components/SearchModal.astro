---
// src/components/SearchModal.astro
// Global Search Modal with rich result cards, fuzzy matching, and keyboard navigation (Ctrl + K)
---

<!-- Search Modal Backdrop & Container -->
<div id="search-modal-backdrop" class="search-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Global Search">
  <div class="search-dialog" id="search-modal-dialog">
    <!-- Header -->
    <div class="search-dialog-header">
      <div class="search-input-wrapper">
        <svg class="search-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="text"
          id="search-modal-input"
          class="search-input"
          placeholder="Search articles, projects, topics, tags..."
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        />
        <button id="search-modal-clear" class="search-clear-btn" aria-label="Clear search" type="button" style="display: none;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <button id="search-modal-close" class="search-close-badge" type="button" aria-label="Close search (Esc)" title="Close (Esc)">
        <kbd class="kbd-esc">ESC</kbd>
      </button>
    </div>

    <!-- Results Area -->
    <div id="search-modal-results" class="search-dialog-body" tabindex="-1">
      <div class="search-initial-state">
        <div class="initial-section-title">Quick Access &amp; Navigation</div>
        <div class="initial-shortcuts">
          <a href="/blog" class="initial-pill">
            <span class="pill-icon">📄</span>
            <span>All Articles</span>
          </a>
          <a href="/projects" class="initial-pill">
            <span class="pill-icon">📦</span>
            <span>All Projects</span>
          </a>
          <a href="/tags" class="initial-pill">
            <span class="pill-icon">🏷️</span>
            <span>All Tags</span>
          </a>
          <a href="/about" class="initial-pill">
            <span class="pill-icon">👤</span>
            <span>About</span>
          </a>
        </div>
        <div class="initial-hint">
          Type any keyword (e.g., <code>obsidian</code>, <code>astro</code>, <code>typography</code>, <code>scatterleaf</code>) to filter in real-time.
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="search-dialog-footer">
      <div class="search-shortcuts-guide">
        <span class="guide-item"><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
        <span class="guide-item"><kbd>↵</kbd> Select</span>
        <span class="guide-item"><kbd>ESC</kbd> Close</span>
      </div>
      <div class="search-brand-note">
        🪨 Minrock Search
      </div>
    </div>
  </div>
</div>

<script>
  import { getTechIconSvg, getDefaultDocIcon } from '../utils/techIcons';

  interface SearchItem {
    id: string;
    type: 'post' | 'project';
    title: string;
    description: string;
    url: string;
    date: string;
    tags: string[];
    category?: string;
    emoji?: string;
  }

  interface TagItem {
    name: string;
    count: number;
    url: string;
  }

  interface SearchData {
    posts: SearchItem[];
    projects: SearchItem[];
    tags: TagItem[];
  }

  let searchData: SearchData | null = null;
  let isFetching = false;
  let selectedIndex = -1;
  let navigableElements: HTMLElement[] = [];

  const backdrop = document.getElementById('search-modal-backdrop');
  const input = document.getElementById('search-modal-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('search-modal-clear');
  const closeBtn = document.getElementById('search-modal-close');
  const resultsContainer = document.getElementById('search-modal-results');

  const initialHtml = resultsContainer ? resultsContainer.innerHTML : '';

  async function loadSearchData(): Promise<SearchData | null> {
    if (searchData) return searchData;
    if (isFetching) return null;
    isFetching = true;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        searchData = await res.json();
      }
    } catch (err) {
      console.error('Error loading search index:', err);
    } finally {
      isFetching = false;
    }
    return searchData;
  }

  // Preload on idle
  window.addEventListener('load', () => {
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(() => loadSearchData());
    } else {
      setTimeout(loadSearchData, 1500);
    }
  });

  function openSearchModal() {
    if (!backdrop) return;
    backdrop.classList.add('open');
    backdrop.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    loadSearchData();
    setTimeout(() => {
      input?.focus();
      input?.select();
    }, 50);
  }

  function closeSearchModal() {
    if (!backdrop) return;
    backdrop.classList.remove('open');
    backdrop.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (input) input.value = '';
    if (clearBtn) clearBtn.style.display = 'none';
    if (resultsContainer) resultsContainer.innerHTML = initialHtml;
    selectedIndex = -1;
    navigableElements = [];
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function highlightText(text: string, query: string): string {
    if (!text) return '';
    if (!query) return escapeHtml(text);
    const tokens = query.trim().split(/\s+/).filter(Boolean);
    if (tokens.length === 0) return escapeHtml(text);

    const escapedTokens = tokens
      .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
      .filter(Boolean);
    if (escapedTokens.length === 0) return escapeHtml(text);

    const regex = new RegExp(`(${escapedTokens.join('|')})`, 'gi');
    const parts = text.split(regex);
    return parts
      .map((part) => {
        if (regex.test(part)) {
          return `<mark class="search-match">${escapeHtml(part)}</mark>`;
        }
        return escapeHtml(part);
      })
      .join('');
  }

  function normalizeStr(str: string): string {
    return str
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
  }

  function resolveItemIcon(item: SearchItem): string {
    if (item.type === 'project') {
      if (item.emoji) {
        return `<span style="font-size: 15px; line-height: 1;">${escapeHtml(item.emoji)}</span>`;
      }
      return getTechIconSvg('vault', 16);
    }

    // Check tags or title for matching tech
    const allText = (item.title + ' ' + (item.tags || []).join(' ')).toLowerCase();
    if (allText.includes('obsidian')) return getTechIconSvg('obsidian', 16);
    if (allText.includes('astro') || allText.includes('ssg')) return getTechIconSvg('astro', 16);
    if (allText.includes('vault')) return getTechIconSvg('vault', 16);
    if (allText.includes('scatterleaf') || allText.includes('comment')) return getTechIconSvg('scatterleaf', 16);
    if (allText.includes('github') || allText.includes('git')) return getTechIconSvg('github', 16);
    if (allText.includes('gallery') || allText.includes('photo') || allText.includes('zoom')) return getTechIconSvg('gallery', 16);
    if (allText.includes('typography') || allText.includes('writing')) return getTechIconSvg('typography', 16);
    if (allText.includes('code')) return getTechIconSvg('code', 16);

    return getDefaultDocIcon(16);
  }

  function renderResults(query: string) {
    if (!resultsContainer) return;
    const cleanQuery = query.trim();
    if (!cleanQuery) {
      resultsContainer.innerHTML = initialHtml;
      selectedIndex = -1;
      navigableElements = [];
      return;
    }

    if (!searchData) {
      resultsContainer.innerHTML = `
        <div class="search-empty">
          <div class="search-empty-icon">⏳</div>
          <div class="search-empty-title">Loading search index...</div>
        </div>
      `;
      return;
    }

    const normQuery = normalizeStr(cleanQuery);
    const queryTokens = normQuery.split(/\s+/).filter(Boolean);

    // Filter Posts
    const matchedPosts = searchData.posts
      .map((post) => {
        const titleNorm = normalizeStr(post.title);
        const descNorm = normalizeStr(post.description);
        const tagsNorm = post.tags.map((t) => normalizeStr(t));

        let score = 0;
        for (const token of queryTokens) {
          if (titleNorm.includes(token)) score += 50;
          if (titleNorm.startsWith(token)) score += 30;
          if (tagsNorm.some((t) => t.includes(token))) score += 40;
          if (descNorm.includes(token)) score += 15;
        }
        return { item: post, score };
      })
      .filter((e) => e.score > 0)
      .sort((a, b) => b.score - a.score)
      .map((e) => e.item);

    // Filter Projects
    const matchedProjects = searchData.projects
      .map((proj) => {
        const titleNorm = normalizeStr(proj.title);
        const descNorm = normalizeStr(proj.description);
        const tagsNorm = proj.tags.map((t) => normalizeStr(t));
        const catNorm = proj.category ? normalizeStr(proj.category) : '';

        let score = 0;
        for (const token of queryTokens) {
          if (titleNorm.includes(token)) score += 50;
          if (titleNorm.startsWith(token)) score += 30;
          if (tagsNorm.some((t) => t.includes(token))) score += 40;
          if (catNorm.includes(token)) score += 25;
          if (descNorm.includes(token)) score += 15;
        }
        return { item: proj, score };
      })
      .filter((e) => e.score > 0)
      .sort((a, b) => b.score - a.score)
      .map((e) => e.item);

    // Filter Tags
    const matchedTags = searchData.tags.filter((tag) => {
      const tagNorm = normalizeStr(tag.name);
      return queryTokens.every((token) => tagNorm.includes(token));
    });

    const totalMatches = matchedPosts.length + matchedProjects.length + matchedTags.length;

    if (totalMatches === 0) {
      resultsContainer.innerHTML = `
        <div class="search-empty">
          <div class="search-empty-icon">🔍</div>
          <div class="search-empty-title">No results found for "${escapeHtml(cleanQuery)}"</div>
          <div class="search-empty-desc">Try searching for keywords like <code>obsidian</code>, <code>astro</code>, <code>vault</code> or <code>ssg</code>.</div>
        </div>
      `;
      selectedIndex = -1;
      navigableElements = [];
      return;
    }

    let html = '';

    // Render Posts
    if (matchedPosts.length > 0) {
      html += `
        <div class="search-category-group">
          <div class="search-category-title">
            <span>📄 Blog Articles</span>
            <span class="search-category-count">${matchedPosts.length}</span>
          </div>
      `;
      for (const post of matchedPosts) {
        html += `
          <a href="${post.url}" class="search-result-item" data-search-item>
            <div class="search-result-icon">${resolveItemIcon(post)}</div>
            <div class="search-result-content">
              <div class="search-result-top">
                <div class="search-result-title">${highlightText(post.title, cleanQuery)}</div>
                <div class="search-result-meta">${post.date}</div>
              </div>
              <div class="search-result-desc">${highlightText(post.description, cleanQuery)}</div>
              <div class="search-result-tags">
                ${post.tags.slice(0, 4).map((t) => `<span class="search-result-badge">#${highlightText(t, cleanQuery)}</span>`).join('')}
              </div>
            </div>
          </a>
        `;
      }
      html += `</div>`;
    }

    // Render Projects
    if (matchedProjects.length > 0) {
      html += `
        <div class="search-category-group">
          <div class="search-category-title">
            <span>📦 Projects</span>
            <span class="search-category-count">${matchedProjects.length}</span>
          </div>
      `;
      for (const proj of matchedProjects) {
        html += `
          <a href="${proj.url}" class="search-result-item" data-search-item>
            <div class="search-result-icon">${resolveItemIcon(proj)}</div>
            <div class="search-result-content">
              <div class="search-result-top">
                <div class="search-result-title">${highlightText(proj.title, cleanQuery)}</div>
                <div class="search-result-meta">${proj.category || 'Project'}</div>
              </div>
              <div class="search-result-desc">${highlightText(proj.description, cleanQuery)}</div>
              <div class="search-result-tags">
                <span class="search-result-badge series-badge">⚡ ${escapeHtml(proj.category || 'Project')}</span>
                ${proj.tags.slice(0, 3).map((t) => `<span class="search-result-badge">#${highlightText(t, cleanQuery)}</span>`).join('')}
              </div>
            </div>
          </a>
        `;
      }
      html += `</div>`;
    }

    // Render Tags
    if (matchedTags.length > 0) {
      html += `
        <div class="search-category-group">
          <div class="search-category-title">
            <span>🏷️ Tags &amp; Topics</span>
            <span class="search-category-count">${matchedTags.length}</span>
          </div>
          <div class="search-tags-grid">
      `;
      for (const tag of matchedTags) {
        html += `
          <a href="${tag.url}" class="search-tag-item" data-search-item>
            <span>#${highlightText(tag.name, cleanQuery)}</span>
            <span class="search-tag-count">(${tag.count})</span>
          </a>
        `;
      }
      html += `</div></div>`;
    }

    resultsContainer.innerHTML = html;

    navigableElements = Array.from(resultsContainer.querySelectorAll('[data-search-item]')) as HTMLElement[];
    selectedIndex = navigableElements.length > 0 ? 0 : -1;
    updateSelection();

    // Attach mouseenter to update selected index on hover
    navigableElements.forEach((el, idx) => {
      el.addEventListener('mouseenter', () => {
        selectedIndex = idx;
        updateSelection();
      });
    });
  }

  function updateSelection() {
    navigableElements.forEach((el, idx) => {
      if (idx === selectedIndex) {
        el.classList.add('selected');
        el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      } else {
        el.classList.remove('selected');
      }
    });
  }

  // Input event
  input?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value;
    if (clearBtn) {
      clearBtn.style.display = val ? 'inline-flex' : 'none';
    }
    renderResults(val);
  });

  clearBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      input.focus();
    }
    if (clearBtn) clearBtn.style.display = 'none';
    renderResults('');
  });

  closeBtn?.addEventListener('click', closeSearchModal);

  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closeSearchModal();
  });

  // Global Keyboard Shortcuts
  window.addEventListener('keydown', (e) => {
    const isOpen = backdrop?.classList.contains('open');

    // Trigger search: Ctrl + K, Cmd + K, or "/"
    if (!isOpen) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearchModal();
        return;
      }
      const path = (typeof e.composedPath === 'function' ? e.composedPath() : []) as HTMLElement[];
      const isTypingInField = path.some((el) => {
        if (!el || !el.tagName) return false;
        const tag = el.tagName.toLowerCase();
        return tag === 'input' || tag === 'textarea' || el.isContentEditable;
      });
      if (e.key === '/' && !isTypingInField) {
        e.preventDefault();
        openSearchModal();
        return;
      }
    }

    if (isOpen) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeSearchModal();
        return;
      }

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (navigableElements.length > 0) {
          selectedIndex = (selectedIndex + 1) % navigableElements.length;
          updateSelection();
        }
        return;
      }

      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (navigableElements.length > 0) {
          selectedIndex = (selectedIndex - 1 + navigableElements.length) % navigableElements.length;
          updateSelection();
        }
        return;
      }

      if (e.key === 'Enter') {
        if (selectedIndex >= 0 && selectedIndex < navigableElements.length) {
          e.preventDefault();
          const targetEl = navigableElements[selectedIndex] as HTMLAnchorElement;
          targetEl.click();
        }
      }
    }
  });

  // Connect triggers from header or mobile
  function bindTriggers() {
    const triggers = document.querySelectorAll('#header-search-btn, #mobile-search-btn');
    triggers.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openSearchModal();
      });
    });
  }

  bindTriggers();
  document.addEventListener('astro:after-swap', bindTriggers);
</script>

<style>
  /* Backdrop */
  .search-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 3.5rem 1rem 2rem;
    overflow-y: auto;
    align-items: flex-start;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .search-backdrop.open {
    display: flex;
    opacity: 1;
  }

  /* Dialog Container */
  .search-dialog {
    width: 100%;
    max-width: 620px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.97) translateY(-8px);
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-backdrop.open .search-dialog {
    transform: scale(1) translateY(0);
  }

  /* Header */
  .search-dialog-header {
    display: flex;
    align-items: center;
    padding: 0.85rem 1.15rem;
    border-bottom: 1px solid var(--border);
    gap: 0.75rem;
    background: var(--bg-surface);
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 0.65rem;
  }

  .search-input-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--text);
    outline: none;
    min-width: 0;
  }

  .search-input::placeholder {
    color: var(--text-muted);
    opacity: 0.8;
  }

  .search-clear-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: var(--border);
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
    transition: background 0.15s, color 0.15s;
  }

  .search-clear-btn:hover {
    background: var(--text-muted);
    color: var(--bg);
  }

  .search-close-badge {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .kbd-esc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  /* Body & Results */
  .search-dialog-body {
    max-height: 55vh;
    overflow-y: auto;
    padding: 0.85rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    outline: none;
  }

  .search-dialog-body::-webkit-scrollbar {
    width: 6px;
  }
  .search-dialog-body::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
  }

  /* Initial state */
  .search-initial-state {
    padding: 1.25rem 0.75rem;
    text-align: center;
  }

  .initial-section-title {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .initial-shortcuts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .initial-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.82rem;
    color: var(--text);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s, background-color 0.15s;
  }

  .initial-pill:hover {
    border-color: var(--accent);
    background: var(--bg-subtle);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .initial-hint {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .initial-hint code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.1rem 0.35rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--accent);
  }

  /* Result Categories */
  :global(.search-category-group) {
    margin-bottom: 1.15rem;
  }

  :global(.search-category-group:last-child) {
    margin-bottom: 0.25rem;
  }

  :global(.search-category-title) {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
    color: var(--text-muted);
    padding: 0.35rem 0.65rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }

  :global(.search-category-count) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    opacity: 0.75;
  }

  /* Result Item Cards */
  :global(.search-result-item) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    margin-bottom: 0.45rem;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease, transform 0.12s ease;
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.selected) {
    background: var(--bg-subtle);
    border-color: var(--accent);
    transform: translateY(-1px);
