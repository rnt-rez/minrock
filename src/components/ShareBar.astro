---
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  url?: string;
}

const { url = '' } = Astro.props;

const linkedinUrl = siteConfig.socialLinks.linkedin || 'https://www.linkedin.com/in/renato-rz/';
const githubUrl = 'https://github.com/rnt-rez';
---

<div class="share-bar" aria-label="Share and connect">
  <span class="share-label">Share:</span>
  <div class="share-buttons">
    <!-- LinkedIn -->
    <a
      href={linkedinUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      title="LinkedIn (Renato Rezende)"
      aria-label="LinkedIn (Renato Rezende)"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6 1.6 1.6 0 0 0-1.6-1.6Z"/>
      </svg>
    </a>

    <!-- GitHub -->
    <a
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      title="GitHub (rnt-rez)"
      aria-label="GitHub (rnt-rez)"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
      </svg>
    </a>

    <!-- Copy Link -->
    <button
      type="button"
      class="share-btn copy-link-btn"
      title="Copy article link"
      aria-label="Copy link to clipboard"
      data-url={url}
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="copy-icon">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
      </svg>
      <span class="copy-text">Copy link</span>
    </button>
  </div>
</div>

<script>
  function setupCopyButtons() {
    const copyBtns = document.querySelectorAll('.copy-link-btn');
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-url') || window.location.href;
        const textSpan = btn.querySelector('.copy-text');
        try {
          await navigator.clipboard.writeText(url);
          if (textSpan) textSpan.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            if (textSpan) textSpan.textContent = 'Copy link';
            btn.classList.remove('copied');
          }, 2000);
        } catch {
          // Fallback
          prompt('Copy this link:', url);
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:after-swap', setupCopyButtons);
</script>

<style>
  .share-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 0;
    margin-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .share-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .share-buttons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--bg-surface);
    color: var(--text);
    font-size: 0.82rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .share-btn:hover {
    background-color: var(--bg-subtle);
    border-color: var(--accent);
    color: var(--accent);
  }

  .share-btn.copied {
    border-color: #10b981;
    color: #10b981;
  }
</style>
