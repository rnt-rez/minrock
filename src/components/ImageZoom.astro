---
// src/components/ImageZoom.astro
// PhotoSwipe 5 lightbox with dynamic image sizing & gallery support
import 'photoswipe/style.css';
---

<script>
  import PhotoSwipe, { type Bounds } from 'photoswipe';

  let activePswp: PhotoSwipe | null = null;

  function openPhotoSwipe(targetImg: HTMLImageElement) {
    if (activePswp) {
      try {
        activePswp.destroy();
      } catch {
        // ignore if already destroyed
      }
      activePswp = null;
    }

    const isAvatar = targetImg.matches('.avatar-zoomable');

    // Find gallery group: images within the same article or post body
    let list: HTMLImageElement[] = [];
    if (isAvatar) {
      list = [targetImg];
    } else {
      const container = targetImg.closest('article, .post-content, .prose, .post-main, main') || document.querySelector('article') || document.body;
      const images = Array.from(
        container.querySelectorAll<HTMLImageElement>('.post-content img, .prose img, .post-cover img, .cover-img, [data-zoomable]')
      ).filter(img => !img.matches('.avatar-zoomable'));

      list = images.length > 0 && images.includes(targetImg) ? images : [targetImg];
    }

    const index = list.indexOf(targetImg);

    const dataSource = list.map((img) => {
      const naturalW = Number(img.naturalWidth || 0);
      const naturalH = Number(img.naturalHeight || 0);
      const rect = img.getBoundingClientRect();
      const isSvg = (img.currentSrc || img.src || '').toLowerCase().includes('.svg');

      const aspect =
        naturalW > 0 && naturalH > 0
          ? naturalW / naturalH
          : rect.width > 0 && rect.height > 0
            ? rect.width / rect.height
            : 16 / 9;

      // Ensure SVGs have high virtual resolution (1920px) so deep zooming renders sharp details
      const baseW = isSvg ? Math.max(naturalW, 1920) : Math.max(naturalW, 1400);

      return {
        src: img.currentSrc || img.src,
        msrc: img.currentSrc || img.src,
        w: Math.round(baseW),
        h: Math.round(baseW / aspect),
        element: img,
        alt: img.alt || '',
      };
    });

    const pswp = new PhotoSwipe({
      dataSource,
      index: index >= 0 ? index : 0,
      closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
      zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
      padding: { top: 20, bottom: 20, left: 20, right: 20 },
      showHideAnimationType: 'zoom',
      showAnimationDuration: 280,
      hideAnimationDuration: 240,
      wheelToZoom: true,
      arrowPrev: list.length > 1,
      arrowNext: list.length > 1,
      imageClickAction: 'zoom-or-close',
      tapAction: 'zoom-or-close',
      doubleTapAction: 'zoom',
      secondaryZoomLevel: (zoomLevelObject) => Math.max(zoomLevelObject.fit * 1.8, 1.4),
      maxZoomLevel: (zoomLevelObject) => Math.max(zoomLevelObject.fit * 3.5, 2.5),
      bgOpacity: 0.94,
    });

    // Viewport-based thumbBounds for smooth opening/closing transition
    pswp.addFilter('thumbBounds', (thumbBounds, itemData): Bounds => {
      const el = itemData.element;
      if (el && el instanceof HTMLElement) {
        const rect = el.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          return {
            x: rect.left,
            y: rect.top,
            w: rect.width,
          };
        }
      }
      return thumbBounds ?? { x: 0, y: 0, w: 0 };
    });

    pswp.on('destroy', () => {
      if (activePswp === pswp) {
        activePswp = null;
      }
    });

    activePswp = pswp;
    pswp.init();
  }

  function handleImageClick(e: MouseEvent) {
    const target = e.target;
    if (!target || !(target instanceof HTMLImageElement)) return;

    const isZoomable = target.matches('.post-content img, .prose img, .post-cover img, .cover-img, .avatar-zoomable, [data-zoomable]');
    if (!isZoomable) return;

    // If image is inside an external/navigation link, let standard navigation occur unless it's a direct image link
    const parentLink = target.closest('a');
    if (parentLink) {
      const href = parentLink.getAttribute('href') || '';
      const isImageFile = href.match(/\.(png|jpe?g|webp|svg|gif|avif)(\?.*)?$/i);
      if (!isImageFile && href !== '#' && href !== '') {
        return;
      }
      e.preventDefault();
    }

    e.preventDefault();
    e.stopPropagation();
    openPhotoSwipe(target);
  }

  // Initialize listener once globally on window/document
  if (!(window as any).__imageZoomInitialized) {
    (window as any).__imageZoomInitialized = true;
    document.addEventListener('click', handleImageClick, false);

    document.addEventListener('astro:before-swap', () => {
      if (activePswp) {
        try {
          activePswp.destroy();
        } catch {
          // ignore
        }
        activePswp = null;
      }
    });
  }
</script>

<style is:global>
  .post-content img,
  .prose img,
  .post-cover img,
  .cover-img,
  .avatar-zoomable,
  [data-zoomable] {
    cursor: zoom-in;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .post-content img:hover,
  .prose img:hover,
  .post-cover img:hover,
  .cover-img:hover {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
  }

  /* Don't show zoom cursor if image is inside a non-image link */
  a:not([data-pswp]) > .post-content img,
  a:not([data-pswp]) > .prose img,
  .post-content a:not([data-pswp]) img,
  .prose a:not([data-pswp]) img {
    cursor: pointer;
  }

  /* PhotoSwipe UI controls styling */
  .pswp__button {
    transition: background 0.15s ease, transform 0.15s ease !important;
    background: rgba(0, 0, 0, 0.45) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    align-items: center;
    justify-content: center;
    width: 44px !important;
    height: 44px !important;
    border-radius: 12px !important;
  }

  .pswp__button:not([style*="display: none"]):not([disabled]) {
    display: flex;
  }

  .pswp__button:hover {
    background: rgba(0, 0, 0, 0.65) !important;
  }

  .pswp__button:active {
    transform: scale(0.9) !important;
  }

  .pswp__button--zoom,
  .pswp__button--close {
    margin-top: 1rem !important;
  }

  .pswp__button--zoom {
    margin-right: 0.625rem !important;
  }

  .pswp__button--close {
    margin-right: 1.25rem !important;
  }
</style>
