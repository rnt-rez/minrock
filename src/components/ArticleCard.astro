---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../config/site';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
const showTags = siteConfig.features?.tags !== false;
---

<article class="article-card">
  <div class="card-meta">
    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
    {showTags && post.data.tags && post.data.tags.length > 0 && (
      <div class="tags-row">
        <span class="tags">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag">
              #{tag}
            </a>
          ))}
        </span>
        <a href={`/blog/${post.id}`} class="tags-more" hidden></a>
      </div>
    )}
  </div>

  <h2 class="card-title">
    <a href={`/blog/${post.id}`}>
      {post.data.title}
    </a>
  </h2>

  <p class="card-desc">
    {post.data.description}
  </p>
</article>

<style>
  .article-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .article-card:last-child {
    border-bottom: none;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .card-meta time {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .tags-row {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    flex: 1;
    min-width: 0;
  }

  /* Clamp to a single row: tag height = line + vertical padding + border. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    font-size: 0.8rem;
    max-height: calc(1lh + 0.24rem + 2px);
    overflow: hidden;
  }

  .tags-more {
    flex-shrink: 0;
    padding: 0.12rem 0.25rem;
    font-size: 0.8rem;
    white-space: nowrap;
    color: var(--text-muted);
    text-decoration: none;
  }

  .tags-more:hover {
    color: var(--accent);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    color: var(--accent);
    font-weight: 500;
    font-size: inherit;
    text-decoration: none;
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
    background-color: transparent;
    border: 1px solid transparent;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tag:hover {
    color: var(--accent);
    background-color: var(--bg-subtle);
    border-color: var(--accent);
  }

  .card-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.35rem;
    border-bottom: none;
    padding-bottom: 0;
  }

  .card-title a {
    color: var(--text);
  }

  .card-title a:hover {
    color: var(--accent);
  }

  .card-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>

<script>
  // Tags are clamped to one row by CSS; count the ones that wrapped out of
  // view and surface them as a "+N more" indicator.
  const updateRow = (row: HTMLElement) => {
    const tags = row.querySelector<HTMLElement>('.tags');
    const more = row.querySelector<HTMLElement>('.tags-more');
    if (!tags || !more) return;

    const items = Array.from(tags.querySelectorAll<HTMLElement>('.tag'));
    const overflowing = () =>
      items.filter((item) => item.offsetTop > items[0].offsetTop);

    // Measure with the indicator already in place, sized for the widest
    // possible label (every tag clipped), so it can't clip more tags later.
    more.textContent = `+${items.length} more`;
    more.hidden = false;

    const clipped = overflowing();
    // Clipped tags are invisible, so keep them out of the tab order.
    items.forEach((item) => {
      item.inert = clipped.includes(item);
    });

    if (clipped.length === 0) {
      more.hidden = true;
      return;
    }

    more.textContent = `+${clipped.length} more`;
    more.title = clipped.map((item) => item.textContent?.trim()).join(', ');
  };

  const observer = new ResizeObserver((entries) => {
    entries.forEach((entry) => updateRow(entry.target as HTMLElement));
  });

  document.querySelectorAll<HTMLElement>('.tags-row').forEach((row) => {
    observer.observe(row);
    document.fonts.ready.then(() => updateRow(row));
  });
</script>
