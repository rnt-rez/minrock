---
import { siteConfig } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Minrock Home">
      <span class="brand-rock">🪨</span>
      <span class="brand-title">{siteConfig.title}</span>
    </a>

    <nav class="nav" aria-label="Main Navigation">
      {siteConfig.navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a href={link.href} class:list={['nav-link', { active: isActive }]} aria-current={isActive ? 'page' : undefined}>
            {link.title}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      {siteConfig.socialLinks.github && (
        <a href={siteConfig.socialLinks.github} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub Repository" title="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
      )}
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 0;
    margin-bottom: 2.5rem;
    background: var(--bg);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .brand-rock {
    font-size: 1.35rem;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  .nav-link.active {
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    color: var(--text-muted);
    transition: color 0.2s ease, transform 0.15s ease;
  }

  .social-icon:hover {
    color: var(--text);
    transform: scale(1.1);
  }

  @media (max-width: 600px) {
    .header-inner {
      flex-wrap: wrap;
    }
  }
</style>
