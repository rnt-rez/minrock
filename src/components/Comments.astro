---
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const comments = siteConfig.comments;

// Se os comentários estiverem globalmente desativados no siteConfig, nada é renderizado
const isEnabled = Boolean(comments?.enabled);
---

{isEnabled && comments && (
  <section class="comments-area" id="comments" aria-label="Article Discussion">
    <div class="comments-divider"></div>
    
    {comments.provider === 'scatterleaf' && (
      <div class="scatterleaf-wrapper">
        <div class="comments-header">
          <h3 class="comments-title">
            <span>🍃</span>
            <span>Discussion & Notes</span>
          </h3>
          <p class="comments-subtitle">
            Iframe-free native comments powered by{' '}
            <a href="https://github.com/rnt-rez/scatterleaf" target="_blank" rel="noopener noreferrer">
              ScatterLeaf
            </a>.
          </p>
        </div>

        <div class="scatterleaf-host">
          <scatter-leaf
            id="post-comments"
            repo={comments.repo}
            category={comments.category || 'General'}
            theme={comments.theme || 'auto'}
            lang={comments.lang || 'auto'}
            broker={comments.broker}
            client-id={comments.clientId}
            title={title}
          ></scatter-leaf>
        </div>

        <script is:inline type="module" src="/scatterleaf.js?v=0.4.9"></script>
      </div>
    )}

    {/* Extension slot: If users want to use Giscus, Utterances, or custom solutions */}
    {comments.provider !== 'scatterleaf' && (
      <div class="custom-comments-slot">
        <slot />
      </div>
    )}
  </section>
)}

<style>
  .comments-area {
    margin-top: 3.5rem;
  }

  .comments-divider {
    height: 1px;
    background: var(--border);
    margin-bottom: 2.5rem;
  }

  .comments-header {
    margin-bottom: 1.5rem;
  }

  .comments-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    color: var(--text-main);
  }

  .comments-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .comments-subtitle a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .scatterleaf-host {
    min-height: 120px;
  }
</style>
