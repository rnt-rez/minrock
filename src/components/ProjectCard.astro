---
export interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  stars?: number;
  repoUrl?: string;
  demoUrl?: string;
  category?: string;
  emoji?: string;
}

const { title, description, slug, tags = [], stars = 0, repoUrl, demoUrl, category, emoji = '📦' } = Astro.props;
---

<article class="project-card" data-card-link={`/projects/${slug}`}>
  <div class="project-header">
    <div class="project-title-wrap">
      <span class="project-emoji">{emoji}</span>
      <a href={`/projects/${slug}`} class="project-title">
        {title}
      </a>
      {category && <span class="category-badge">{category}</span>}
    </div>
    <div class="project-links">
      {stars > 0 && (
        <span class="project-stars" title={`${stars} stars`}>★ {stars}</span>
      )}
      {repoUrl && (
        <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="project-action-link" title="Repository">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          Repo
        </a>
      )}
      {demoUrl && (
        <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="project-action-link" title="Live Demo">
          Demo ↗
        </a>
      )}
    </div>
  </div>

  <p class="project-desc">{description}</p>

  {tags.length > 0 && (
    <div class="project-tags">
      {tags.map((tag) => (
        <a href={`/tags/${tag}`} class="tag-badge">
          #{tag}
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background-color: var(--bg-surface);
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.15s ease;
  }

  .project-card:hover {
    border-color: var(--accent);
    background-color: var(--bg-subtle);
    transform: translateY(-2px);
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .project-emoji {
    font-size: 1.1rem;
  }

  .project-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .project-title:hover {
    color: var(--accent);
  }

  .category-badge {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background-color: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .project-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .project-stars {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: #b45309;
    font-weight: 600;
  }

  :global([data-theme="slate"]) .project-stars,
  :global([data-theme="midnight"]) .project-stars {
    color: #fbbf24;
  }

  .project-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background-color: var(--bg);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .project-action-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .project-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .project-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.35rem;
  }

  .tag-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
    padding: 0.1rem 0.42rem;
    border-radius: 4px;
    background-color: transparent;
    border: 1px solid transparent;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tag-badge:hover {
    color: var(--accent);
    background-color: var(--bg-subtle);
    border-color: var(--accent);
    transform: translateY(-1.5px) scale(1.04);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .tag-badge:active {
    transform: translateY(0) scale(0.98);
  }
</style>
