---
// Client-side script to inject copy buttons into all <pre> code blocks
---

<script>
  function setupCodeCopyButtons() {
    const preBlocks = document.querySelectorAll('pre');

    preBlocks.forEach((pre) => {
      // Avoid duplicate buttons
      if (pre.querySelector('.code-copy-btn')) return;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy-btn';
      button.setAttribute('aria-label', 'Copy code to clipboard');
      button.innerHTML = `
        <svg class="copy-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
        </svg>
        <span class="copy-label">Copy</span>
      `;

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const textToCopy = code ? code.innerText : pre.innerText;

        try {
          await navigator.clipboard.writeText(textToCopy);
          button.classList.add('copied');
          const label = button.querySelector('.copy-label');
          if (label) label.textContent = 'Copied!';

          setTimeout(() => {
            button.classList.remove('copied');
            if (label) label.textContent = 'Copy';
          }, 2000);
        } catch {
          // Fallback
        }
      });

      pre.style.position = 'relative';
      pre.appendChild(button);
    });
  }

  setupCodeCopyButtons();
  document.addEventListener('astro:after-swap', setupCodeCopyButtons);
</script>

<style is:global>
  pre {
    position: relative;
  }

  .code-copy-btn {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
    font-family: var(--font-sans);
    color: var(--code-text, #e2e8f0);
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    user-select: none;
    z-index: 10;
  }

  pre:hover .code-copy-btn,
  .code-copy-btn:focus-visible {
    opacity: 1;
  }

  .code-copy-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .code-copy-btn.copied {
    opacity: 1;
    color: #34d399;
    border-color: #34d399;
  }
</style>
