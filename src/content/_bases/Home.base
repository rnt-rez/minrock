filters:
  and:
    - file.ext == "md"
formulas:
  Slug: |-
    if(file.folder == "blog", "/blog/" + file.name.replace(".md", ""), 
      "/" + file.folder)
  Content Folder: |-
    if(file.name == "index",
      if(file.folder != "",
        if(file.folder.replace("/" + file.folder.replace(/.*\//, ""), "") != "",
          file.folder.replace("/" + file.folder.replace(/.*\//, ""), ""),
          file.folder
        ),
        "root"
      ),
      if(file.folder != "",
        file.folder,
        "root"
      )
    )
properties:
  file.fullname:
    displayName: Full File Name
  file.name:
    displayName: File Name
  formula.Slug:
    displayName: Path
  note.date:
    displayName: Date
  note.description:
    displayName: Description
  note.draft:
    displayName: Draft
  note.image:
    displayName: Image
  note.pubDate:
    displayName: PubDate
  note.tags:
    displayName: Tags
  note.title:
    displayName: Title
views:
  - type: cms
    name: Blog
    filters:
      and:
        - file.folder.startsWith("blog")
    order: []
    sort:
      - property: pubDate
        direction: DESC
    fallbackToEmbeds: never
    propertyDisplay1: note.pubDate
    showTextPreview: true
    imageFormat: cover
    imageProperty: note.image
    showDate: true
    showDraftStatus: true
    draftStatusProperty: note.draft
    propertyLabels: above
    titleProperty: note.title
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: true
    tagsProperty: note.tags
    customizeNewButton: true
    newNoteLocation: blog
    cardSize: 250
    imageAspectRatio: 0.55
    maxTagsToShow: 3
    dateIncludeTime: false
    descriptionProperty: note.description
    hideQuickEditIcon: false
  - type: cms
    name: Vault CMS Guide
    filters:
      and:
        - file.name.endsWith("GUIDE")
    order: []
    sort:
      - property: file.ctime
        direction: DESC
    fallbackToEmbeds: never
    propertyDisplay1: file.fullname
    showTextPreview: true
    imageFormat: none
    showDate: false
    showDraftStatus: false
    propertyLabels: above
    titleProperty: note.title
    showTags: false
    cardSize: 250
    descriptionProperty: note.description
