{
  "name": "minrock",
  "type": "module",
  "version": "0.2.2",
  "description": "Minimalist, typography-first Astro 7 theme crafted for technical writers and Obsidian vaults. Pure SSG, zero bloat.",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Renato Rezende (https://github.com/rnt-rez)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnt-rez/minrock.git"
  },
  "bugs": {
    "url": "https://github.com/rnt-rez/minrock/issues"
  },
  "homepage": "https://github.com/rnt-rez/minrock#readme",
  "keywords": [
    "astro",
    "astro-theme",
    "obsidian",
    "obsidian-vault",
    "obsidian-md",
    "obsidian-publish",
    "typography",
    "blog-theme",
    "ssg",
    "technical-writing",
    "minimalist"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "qa": "astro check && astro build",
    "audit:wcag": "node scripts/audit-wcag.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "audit:google": "node scripts/audit-google-search.mjs",
    "astro": "astro",
    "postinstall": "node scripts/sign-native-bindings.js",
    "prepare": "husky",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.13.9",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
